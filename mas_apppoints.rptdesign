<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Eclipse BIRT Designer Version 4.3.1.v201309091055 Build &lt;4.3.1.v20130918-1142></property>
    <html-property name="description">MAS AppPoint estimate (Magic Script 2.6.3 logic, read-only)</html-property>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.com.ibm.tivoli.maximo.report.script);
mxReportScriptContext = MXReportScriptContext.initialize(reportContext);
scriptLogger = mxReportScriptContext.getReportScriptLogger();
daysBack = parseInt(params["Days_Back"].value);
ownedAP = parseInt(params["Owned_AppPoints"].value);
if (isNaN(ownedAP) || ownedAP < 0) ownedAP = 0;
if (isNaN(daysBack) || daysBack < 1) daysBack = 90;
if (daysBack > 730) daysBack = 730;


function dbKind(ds) {
  var n = String(ds.getDatabaseProductName()).toLowerCase();
  if (n.indexOf("oracle") >= 0) return "oracle";
  if (n.indexOf("microsoft") >= 0 || n.indexOf("sql server") >= 0) return "sqlserver";
  return "db2";
}
// Read-only port of IBM Magic Script 2.6.3. Same user-type rules, no tables or indexes created.
// One builder, three dialects: "oracle", "sqlserver", "db2" (Maximo 7.6 supported databases).
function magicSql(daysBack, db) {
  db = db || "oracle";
  var ORA = db == "oracle", MSS = db == "sqlserver", DB2 = db == "db2";

  // ---- dialect helpers
  function cat() {                       // string concatenation of 2+ expressions
    var a = Array.prototype.slice.call(arguments);
    if (MSS) return "concat(" + a.join(", ") + ")";
    return "(" + a.join(" || ") + ")";
  }
  function str(x) { return MSS ? "cast(" + x + " as varchar(20))" : (ORA ? "to_char(" + x + ")" : "varchar(" + x + ")"); }
  function daysAgo(n) { return ORA ? "(sysdate - " + n + ")" : (MSS ? "dateadd(day, -" + n + ", getdate())" : "(current timestamp - " + n + " days)"); }
  function dayOf(x) { return ORA ? "trunc(" + x + ")" : (MSS ? "cast(" + x + " as date)" : "date(" + x + ")"); }
  function nextDay(x) { return ORA ? "(" + x + " + 1)" : (MSS ? "dateadd(day, 1, " + x + ")" : "(" + x + " + 1 days)"); }
  function fmtStamp(x) { return MSS ? "convert(varchar(16), " + x + ", 120)" : "to_char(" + x + ", 'YYYY-MM-DD HH24:MI')"; }
  function fmtDay(x) { return MSS ? "convert(varchar(10), " + x + ", 120)" : "to_char(" + x + ", 'YYYY-MM-DD')"; }
  function fmtShort(x) { return MSS ? "convert(varchar(9), " + x + ", 6)" : "to_char(" + x + ", 'DD Mon YY')"; }
  var NL = MSS ? "char(10)" : "chr(10)";
  var DUAL = ORA ? " from dual" : (DB2 ? " from sysibm.sysdummy1" : "");
  // Comma list per key. `src` returns distinct (k, v) pairs.
  function listOf(src) {
    if (MSS) return " (select s1.k, stuff((select ', ' + s2.v from (" + src + ") s2 where s2.k = s1.k order by s2.v"
      + " for xml path('')), 1, 2, '') v from (select distinct k from (" + src + ") s0) s1) ";
    return " (select k, listagg(v, ', ') within group (order by v) v from (" + src + ") s group by k) ";
  }

  var SS_EXCL   = "'PLUSCONDRE','PLUSDSPLAN','PLUSCTMPLT','PLUSTVR','PLUSGCRINC','PLUSGVWINC','PLUSGMCR','PLUSPPBILL','TLOAMSWCTG','SFWLICVIEW','CONTSFW','BBOARD','KPI','SRMOBILE'";
  var MOD_EXCL  = "'PLUSCONDRE','PLUSDSPLAN','PLUSCTMPLT','PLUSTVR','PLUSGCRINC','PLUSGVWINC','PLUSGMCR','PLUSPPBILL','TLOAMSWCTG','SFWLICVIEW','CONTSFW','BBOARD','KPI'";
  var RES_EXCL  = "'PLUSCONDRE','TLOAMSWCTG','SFWLICVIEW','CONTSFW','BBOARD','KPI'";
  var PLUS_EXCL = "'PLUSCONDRE','PLUSDSPLAN','PLUSCTMPLT','PLUSTVR','PLUSGCRINC','PLUSGMCR','PLUSPPBILL','PLUSGVWINC'";
  var PLUS_SRC  = "select distinct g.userid k, a.app v from groupuser g join applicationauth a on a.groupname = g.groupname"
    + " where a.optionname = 'INSERT' and a.app like 'PLUS%' and a.app not in (" + PLUS_EXCL + ")";
  var o = {};

  // One row per active/blocked user with the MAS user type and AppPoints.
  o.users =
      " musers as (select u.userid, u.personid, u.status, u.type from maxuser u"
    + "   where u.status in (select value from synonymdomain where domainid = 'MAXUSERSTATUS' and maxvalue in ('ACTIVE','BLOCKED'))),"
    + " gam as (select distinct g.userid, a.app, a.optionname, m.moduleapp from groupuser g"
    + "   join applicationauth a on a.groupname = g.groupname"
    + "   join maxmenu m on m.elementtype = 'APP' and m.menutype = 'MODULE' and m.keyvalue = a.app"
    + "   where a.optionname in ('READ','INSERT','SAVE') and a.app not like '%CONFIG'),"
    + " nonss as (select distinct userid from gam where optionname = 'READ' and app not in (" + SS_EXCL + ")"
    + "   and moduleapp not in ('ANALYTICS','REPORTING','HIDDEN','SSDR','SSDR1','SSDR2')),"
    + " modcnt as (select userid, count(distinct moduleapp) nmod from gam where optionname = 'INSERT' and app not in (" + MOD_EXCL + ")"
    + "   and moduleapp not in ('ANALYTICS','REPORTING','HIDDEN','SSDR','SSDR1','SSDR2','WO') group by userid),"
    + " restr as (select distinct userid from gam where optionname = 'SAVE' and app not in (" + RES_EXCL + ")"
    + "   and moduleapp in ('SCHEDULER','SETUP','INT','UTIL','SECURITY')),"
    + " plusu as (select pl.k userid, pl.v plusapps from" + listOf(PLUS_SRC) + "pl),"
    + " cls as (select u.userid, u.personid, u.status, u.type, coalesce(mc.nmod, 0) nmod,"
    + "   case when r.userid is not null then 'Y' else 'N' end restricted, p.plusapps,"
    + "   case when n.userid is null then 'SELFSERVICE'"
    + "        when coalesce(mc.nmod, 0) <= 3 and r.userid is null then 'LIMITED'"
    + "        when p.userid is not null then 'PREMIUM' else 'BASE' end mastype"
    + "   from musers u left join nonss n on n.userid = u.userid left join modcnt mc on mc.userid = u.userid"
    + "   left join restr r on r.userid = u.userid left join plusu p on p.userid = u.userid),"
    + " clsp as (select c.*, case mastype when 'LIMITED' then 5 when 'BASE' then 10 when 'PREMIUM' then 15 else 0 end points from cls c)";

  // Sessions and the 3 peak concurrent-user moments (on different days) in the window.
  o.peaks =
      " sess as (select maxsessionuid, userid,"
    + "   min(case when attemptresult = 'LOGIN' then attemptdate end) logindate,"
    + "   min(case when attemptresult in ('LOGOUT','RESTART','SYSLOGOUT','TIMEOUT') then attemptdate end) logoutdate"
    + "   from logintracking where attemptdate >= " + daysAgo(daysBack + 1) + " and maxsessionuid is not null"
    + "   and userid not in ('MAXADMIN','MXINTADM','MAXREG') group by maxsessionuid, userid),"
    + " daily as (select " + dayOf("attemptdate") + " d, max(currentcount) cc from logintracking"
    + "   where attemptdate >= " + daysAgo(daysBack) + " and currentcount is not null group by " + dayOf("attemptdate") + "),"
    + " top3 as (select d, cc, row_number() over (order by cc desc, d desc) rn from daily),"
    + " peaks as (select t.rn peakno, t.cc, (select min(x.attemptdate) from logintracking x"
    + "   where x.attemptdate >= t.d and x.attemptdate < " + nextDay("t.d") + " and x.currentcount = t.cc) peakdate from top3 t where t.rn <= 3),"
    + " peakusers as (select distinct p.peakno, p.peakdate, p.cc, s.userid from peaks p join sess s"
    + "   on s.logindate <= p.peakdate and s.logoutdate >= p.peakdate)";

  var TIERS = MSS
    ? " tiers as (select * from (values ('PREMIUM','Premium',1,15), ('BASE','Base',2,10), ('LIMITED','Limited',3,5),"
      + " ('SELFSERVICE','Self service',4,0)) v (mastype, label, sk, pe))"
    : " tiers as (select 'PREMIUM' mastype, 'Premium' label, 1 sk, 15 pe" + DUAL
      + " union all select 'BASE', 'Base', 2, 10" + DUAL
      + " union all select 'LIMITED', 'Limited', 3, 5" + DUAL
      + " union all select 'SELFSERVICE', 'Self service', 4, 0" + DUAL + ")";

  // Per peak: users and AppPoints split by tier.
  var PEAKAGG = " peakagg as (select p.peakno, p.peakdate, p.cc, count(pu.userid) users_at_peak,"
    + " sum(case when c.mastype = 'PREMIUM' then 1 else 0 end) premium,"
    + " sum(case when c.mastype = 'BASE' then 1 else 0 end) base,"
    + " sum(case when c.mastype = 'LIMITED' then 1 else 0 end) limited,"
    + " sum(case when pu.userid is not null and (c.mastype = 'SELFSERVICE' or c.mastype is null) then 1 else 0 end) selfservice,"
    + " coalesce(sum(c.points), 0) points"
    + " from peaks p left join peakusers pu on pu.peakno = p.peakno left join clsp c on c.userid = pu.userid"
    + " group by p.peakno, p.peakdate, p.cc),"
    + " toppeak as (select users_at_peak, peakdate from (select users_at_peak, peakdate,"
    + "   row_number() over (order by points desc, peakno) rn from peakagg) z where rn = 1)";

  // One row of headline numbers for the KPI tiles.
  o.kpiSql = "with " + o.users + "," + o.peaks + "," + PEAKAGG
    + " select (select count(*) from clsp) active_users,"
    + " (select count(*) from clsp where mastype <> 'SELFSERVICE') paying_users,"
    + " (select count(*) from clsp where mastype = 'SELFSERVICE') free_users,"
    + " (select coalesce(sum(points), 0) from clsp) auth_points,"
    + " (select coalesce(max(points), 0) from peakagg) peak_points,"
    + " (select max(users_at_peak) from toppeak) peak_users,"
    + " (select max(" + fmtStamp("peakdate") + ") from toppeak) peak_date,"
    + " (select coalesce(max(cc), 0) from peakagg) peak_count" + DUAL;

  // Always four rows, so the charts and the tier guide show every tier.
  o.typesSql = "with " + o.users + "," + TIERS
    + " select t.mastype, t.label, t.sk, t.pe pointseach, count(c.userid) users, coalesce(sum(c.points), 0) points"
    + " from tiers t left join clsp c on c.mastype = t.mastype"
    + " group by t.mastype, t.label, t.sk, t.pe order by t.sk";

  o.peaksSql = "with " + o.users + "," + o.peaks + "," + PEAKAGG
    + " select peakno, " + cat("'#'", str("peakno"), "'  '", fmtShort("peakdate"), NL, "'Total '", str("points"), "' AP'") + " peaklabel,"
    + " " + fmtStamp("peakdate") + " peakdate, cc currentcount, users_at_peak,"
    + " premium, base, limited, selfservice, premium * 15 premium_pts, base * 10 base_pts, limited * 5 limited_pts, points"
    + " from peakagg order by peakno";

  o.peakUsersSql = "with " + o.users + "," + o.peaks
    + " select pu.peakno, " + cat("'Peak '", str("pu.peakno"), "' - '", fmtStamp("pu.peakdate")) + " peaklabel,"
    + " pu.userid, coalesce(pe.displayname, pu.userid) displayname, coalesce(c.mastype, 'NOT ACTIVE') mastype, coalesce(c.points, 0) points"
    + " from peakusers pu left join clsp c on c.userid = pu.userid left join person pe on pe.personid = c.personid"
    + " order by pu.peakno, coalesce(c.points, 0) desc, pu.userid";

  // Security groups that give Premium users their add-on (PLUS*) create rights.
  var GPLUS_SRC = "select distinct a.groupname k, a.app v from applicationauth a"
    + " where a.optionname = 'INSERT' and a.app like 'PLUS%' and a.app not in (" + PLUS_EXCL + ")";
  o.premGroupsSql = "with " + o.users + ","
    + " gprem as (select g.groupname, count(distinct c.userid) premium_users from groupuser g"
    + "   join clsp c on c.userid = g.userid and c.mastype = 'PREMIUM'"
    + "   where g.groupname in (select gs.k from (" + GPLUS_SRC + ") gs) group by g.groupname)"
    + " select gp.groupname, mg.description, gp.premium_users, gl.v plusapps"
    + " from gprem gp left join maxgroup mg on mg.groupname = gp.groupname"
    + " left join" + listOf(GPLUS_SRC) + "gl on gl.k = gp.groupname"
    + " order by gp.premium_users desc, gp.groupname offset 0 rows fetch next 15 rows only";

  o.usersSql = "with " + o.users + "," + TIERS
    + " select c.userid, pe.displayname, c.status, c.type, c.mastype, t.label tierlabel, t.sk tiersort, c.points, c.nmod, c.restricted, c.plusapps,"
    + " " + fmtDay("ll.lastlogin") + " lastlogin"
    + " from clsp c join tiers t on t.mastype = c.mastype left join person pe on pe.personid = c.personid"
    + " left join (select userid, max(attemptdate) lastlogin from logintracking where attemptresult = 'LOGIN' group by userid) ll on ll.userid = c.userid"
    + " order by t.sk, c.userid";

  // Plain user -> type list, used to compare with IBM's original script.
  o.typeListSql = "with " + o.users + " select userid, mastype from clsp order by userid";
  return o;
}

]]></method>
    <method name="afterFactory"><![CDATA[MXReportScriptContext.close();]]></method>
    <text-property name="displayName">MAS AppPoint Estimate</text-property>
    <property name="layoutPreference">auto layout</property>
    <list-property name="libraries">
        <structure>
            <property name="fileName">MaximoSystemLibrary.rptlibrary</property>
            <property name="namespace">MaximoSystemLibrary</property>
        </structure>
    </list-property>
    <parameters>
        <scalar-parameter name="Days_Back" id="414"><text-property name="promptText">Peak window (days)</text-property><text-property name="helpText">How many days of login history to search for peaks. 1 to 730.</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">90</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="Owned_AppPoints" id="415"><text-property name="promptText">Owned AppPoints</text-property><text-property name="helpText">Your MAS AppPoint entitlement. Leave 0 to skip the headroom tile.</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">0</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="where" id="416">
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">1=1</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="appname" id="417">
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="paramdelimiter" id="418"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="paramstring" id="419"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="usepagebreaks" id="420"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">true</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
    </parameters>
    <data-sources><script-data-source name="maximoDataSource" id="101" extends="MaximoSystemLibrary.maximoDataSource"/>
    </data-sources>
    <data-sets>
        <script-data-set name="dsKpi" id="102">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
                    <property name="name">active_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">paying_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">free_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">auth_points</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">peak_points</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">peak_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">peak_date</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">peak_count</property>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData"><list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">active_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">paying_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">free_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">auth_points</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">peak_points</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">peak_users</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">peak_date</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">peak_count</property>
                    <property name="dataType">integer</property>
                </structure>
            </list-property></structure>
            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[dsKpiDS = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
dsKpiDS.open();
var sqlText = magicSql(daysBack, dbKind(dsKpiDS)).kpiSql;
if (scriptLogger.isDebugEnabled()) scriptLogger.debug("dsKpi sql = " + sqlText);
dsKpiDS.setQuery(sqlText);]]></method>
            <method name="fetch"><![CDATA[if (!dsKpiDS.fetch()) return (false);
row["active_users"] = dsKpiDS.getInteger("active_users");
row["paying_users"] = dsKpiDS.getInteger("paying_users");
row["free_users"] = dsKpiDS.getInteger("free_users");
row["auth_points"] = dsKpiDS.getInteger("auth_points");
row["peak_points"] = dsKpiDS.getInteger("peak_points");
row["peak_users"] = dsKpiDS.getInteger("peak_users");
row["peak_date"] = dsKpiDS.getString("peak_date");
row["peak_count"] = dsKpiDS.getInteger("peak_count");
return (true);]]></method>
            <method name="close"><![CDATA[dsKpiDS.close();]]></method>
        </script-data-set>
        <script-data-set name="dsTypes" id="103">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
                    <property name="name">mastype</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">label</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
