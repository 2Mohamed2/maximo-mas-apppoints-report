    <body>
        <grid id="108">
            <property name="width">10.1in</property>
            <column id="109"><property name="width">7.1in</property></column>
            <column id="110"><property name="width">3.0in</property></column>
            <row id="111">
                <cell id="112"><property name="paddingBottom">4pt</property>
                    <label id="113"><property name="fontSize">20pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">MAS AppPoint Estimate</text-property></label>
                    <label id="114"><property name="fontSize">9.5pt</property><property name="color">#525252</property><text-property name="text">Who uses Maximo, which MAS user type each person maps to, and how many AppPoints that costs at peak.</text-property></label>
                </cell>
                <cell id="115"><property name="textAlign">right</property><property name="verticalAlign">bottom</property><property name="paddingBottom">4pt</property>
                    <data id="116"><property name="fontSize">8pt</property><property name="color">#525252</property><property name="textAlign">right</property>
                        <list-property name="boundDataColumns"><structure><property name="name">run</property>
                            <expression name="expression" type="javascript"><![CDATA["Run " + Formatter.format(new Date(), "yyyy-MM-dd HH:mm") + "\nPeak window: last " + daysBack + " days" + (ownedAP > 0 ? "\nOwned AppPoints: " + ownedAP : "")]]></expression>
                            <property name="dataType">string</property></structure></list-property>
                        <property name="resultSetColumn">run</property>
                    </data>
                </cell>
            </row>
        </grid>
        <grid id="117"><property name="width">10.1in</property><column id="118"/><row id="119"><cell id="120"><property name="borderTopColor">#0f62fe</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingBottom">8pt</property></cell></row></grid>
        <table id="145">
            <property name="width">9.98in</property>
            <property name="dataSet">dsKpi</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">active_users</property>
                    <expression name="expression" type="javascript">dataSetRow["active_users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">paying_users</property>
                    <expression name="expression" type="javascript">dataSetRow["paying_users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">free_users</property>
                    <expression name="expression" type="javascript">dataSetRow["free_users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">auth_points</property>
                    <expression name="expression" type="javascript">dataSetRow["auth_points"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">peak_points</property>
                    <expression name="expression" type="javascript">dataSetRow["peak_points"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">peak_users</property>
                    <expression name="expression" type="javascript">dataSetRow["peak_users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">peak_date</property>
                    <expression name="expression" type="javascript">dataSetRow["peak_date"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">peak_count</property>
                    <expression name="expression" type="javascript">dataSetRow["peak_count"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">k_paying_sub</property>
                    <expression name="expression" type="javascript"><![CDATA[row["free_users"] + (row["free_users"] == 1 ? " self-service user is free" : " self-service users are free")]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">k_active_sub</property>
                    <expression name="expression" type="javascript"><![CDATA["active and blocked user records"]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">k_auth_sub</property>
                    <expression name="expression" type="javascript"><![CDATA["if every paying user were logged in"]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">k_peak_sub</property>
                    <expression name="expression" type="javascript"><![CDATA[row["peak_date"] == null ? "no login peaks found" : row["peak_users"] + (row["peak_users"] == 1 ? " user" : " users") + " in session, " + row["peak_date"]]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">k_head</property>
                    <expression name="expression" type="javascript"><![CDATA[ownedAP > 0 ? ownedAP - row["peak_points"] : null]]></expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">k_head_sub</property>
                    <expression name="expression" type="javascript"><![CDATA[ownedAP > 0 ? ("of " + ownedAP + " owned, " + Math.round(100 * (ownedAP - row["peak_points"]) / ownedAP) + "% left at peak") : "enter Owned_AppPoints to compare"]]></expression>
                    <property name="dataType">string</property>
                </structure>
