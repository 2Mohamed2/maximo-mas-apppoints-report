            <page-footer>
                <grid id="393">
                    <property name="width">10.1in</property>
                    <column id="394"><property name="width">8.1in</property></column>
                    <column id="395"><property name="width">2.0in</property></column>
                    <row id="396">
                        <cell id="397"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><label id="398"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><text-property name="text">MAS AppPoint Estimate - Magic Script 2.6.3 logic, read-only. Estimate, not a licence audit.</text-property></label></cell>
                        <cell id="399"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><property name="textAlign">right</property>
                            <grid id="400"><column id="401"/><column id="402"/><column id="403"/><column id="404"/>
                                <row id="405">
                                    <cell id="406"><label id="407"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">right</property><text-property name="text">Page</text-property></label></cell>
                                    <cell id="408"><auto-text id="409"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">center</property><property name="type">page-number</property></auto-text></cell>
