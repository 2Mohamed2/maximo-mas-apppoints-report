            </list-property></structure>
            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[dsTypesDS = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
dsTypesDS.open();
var sqlText = magicSql(daysBack, dbKind(dsTypesDS)).typesSql;
if (scriptLogger.isDebugEnabled()) scriptLogger.debug("dsTypes sql = " + sqlText);
dsTypesDS.setQuery(sqlText);]]></method>
            <method name="fetch"><![CDATA[if (!dsTypesDS.fetch()) return (false);
row["mastype"] = dsTypesDS.getString("mastype");
row["label"] = dsTypesDS.getString("label");
row["sk"] = dsTypesDS.getInteger("sk");
row["pointseach"] = dsTypesDS.getInteger("pointseach");
row["users"] = dsTypesDS.getInteger("users");
row["points"] = dsTypesDS.getInteger("points");
return (true);]]></method>
            <method name="close"><![CDATA[dsTypesDS.close();]]></method>
        </script-data-set>
        <script-data-set name="dsPeaks" id="104">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
                    <property name="name">peakno</property>
