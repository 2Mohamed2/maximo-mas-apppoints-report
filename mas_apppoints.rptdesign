        </table><label id="254"><property name="fontSize">13pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="marginTop">18pt</property><property name="marginBottom">2pt</property><text-property name="text">All active users by MAS type</text-property></label><label id="253"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">6pt</property><text-property name="text">Sorted by type, then user. "Modules" counts modules with create rights (Work Orders excluded). "Admin apps" means save rights in Security, System Configuration, Integration, Utilities or Scheduler.</text-property></label>
        <table id="264">
            <property name="width">10.10in</property>
            <property name="dataSet">dsUsers</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">userid</property>
