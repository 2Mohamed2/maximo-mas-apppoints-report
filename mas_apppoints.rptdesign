                <structure>
                    <property name="name">displayname</property>
                    <expression name="expression" type="javascript">dataSetRow["displayname"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">status</property>
                    <expression name="expression" type="javascript">dataSetRow["status"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">type</property>
                    <expression name="expression" type="javascript">dataSetRow["type"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">mastype</property>
                    <expression name="expression" type="javascript">dataSetRow["mastype"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">tierlabel</property>
                    <expression name="expression" type="javascript">dataSetRow["tierlabel"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">tiersort</property>
                    <expression name="expression" type="javascript">dataSetRow["tiersort"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">points</property>
                    <expression name="expression" type="javascript">dataSetRow["points"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">nmod</property>
                    <expression name="expression" type="javascript">dataSetRow["nmod"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">restricted</property>
                    <expression name="expression" type="javascript">dataSetRow["restricted"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">plusapps</property>
                    <expression name="expression" type="javascript">dataSetRow["plusapps"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">lastlogin</property>
                    <expression name="expression" type="javascript">dataSetRow["lastlogin"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">lastlogin_txt</property>
                    <expression name="expression" type="javascript"><![CDATA[row["lastlogin"] == null ? "never" : row["lastlogin"]]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">admin_txt</property>
                    <expression name="expression" type="javascript"><![CDATA[row["restricted"] == "Y" ? "yes" : ""]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">g_title</property>
                    <expression name="expression" type="javascript"><![CDATA[row["tierlabel"] + "  -  " + row["g_count"] + (row["g_count"] == 1 ? " user, " : " users, ") + row["g_points"] + " AppPoints if all authorized"]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">g_count</property>
                    <property name="dataType">integer</property>
                    <simple-property-list name="aggregateOn"><value>grpTier</value></simple-property-list>
                    <property name="aggregateFunction">COUNT</property>
                    <list-property name="arguments"><structure><property name="name">Expression</property>
                        <expression name="value" type="javascript">row["userid"]</expression></structure></list-property>
                </structure>
                <structure>
                    <property name="name">g_points</property>
                    <property name="dataType">integer</property>
                    <simple-property-list name="aggregateOn"><value>grpTier</value></simple-property-list>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments"><structure><property name="name">Expression</property>
                        <expression name="value" type="javascript">row["points"]</expression></structure></list-property>
                </structure>
            </list-property>
            <property name="pageBreakInterval">0</property>
