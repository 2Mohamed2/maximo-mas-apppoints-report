name="resultSetColumn">admin_txt</property></data></cell><cell id="301"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="262"><property name="fontSize">8pt</property><property name="color">#525252</property><property name="resultSetColumn">lastlogin_txt</property></data></cell><cell id="302"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="263"><property name="fontSize">7pt</property><property name="color">#525252</property><property name="resultSetColumn">plusapps</property></data></cell></row></detail>
        </table><label id="304"><property name="fontSize">13pt</property><property name="pageBreakBefore">always</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="marginTop">18pt</property><property name="marginBottom">2pt</property><text-property name="text">Appendix A - The four MAS user types</text-property></label><label id="303"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">6pt</property><text-property name="text">Each active user is placed in exactly one type from their security-group rights. The type sets the AppPoints the user costs while logged in.</text-property></label>
        <table id="335">
            <property name="width">10.10in</property>
            <property name="dataSet">dsTypes</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">mastype</property>
                    <expression name="expression" type="javascript">dataSetRow["mastype"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">label</property>
                    <expression name="expression" type="javascript">dataSetRow["label"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">sk</property>
                    <expression name="expression" type="javascript">dataSetRow["sk"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">pointseach</property>
                    <expression name="expression" type="javascript">dataSetRow["pointseach"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">users</property>
                    <expression name="expression" type="javascript">dataSetRow["users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">points</property>
                    <expression name="expression" type="javascript">dataSetRow["points"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">what</property>
                    <expression name="expression" type="javascript"><![CDATA[row["mastype"] == "PREMIUM" ? "Would be Base, and can also create records in at least one add-on or industry-solution application (application names starting PLUS: HSE, Transportation, Asset Configuration Manager, Spatial, Service Provider and similar)." : row["mastype"] == "BASE" ? "Can create records in more than 3 modules (Work Orders are not counted), or can save in an administrative module: Security, System Configuration, Integration, Utilities or Scheduler." : row["mastype"] == "LIMITED" ? "Can create records in up to 3 modules (Work Orders are not counted) and has no administrative applications." : row["mastype"] == "SELFSERVICE" ? "Only uses self-service applications: create and view service requests, Start Center, bulletin board, KPIs and reports. No read access to any other module." : ""]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">reduce</property>
                    <expression name="expression" type="javascript"><![CDATA[row["mastype"] == "PREMIUM" ? "Give read-only access to add-on apps for people who only look. Keep create rights on PLUS apps in a small, dedicated group. Appendix B shows where to start." : row["mastype"] == "BASE" ? "Split broad groups so day-to-day users create in 3 modules or fewer, and keep admin applications in admin-only groups." : row["mastype"] == "LIMITED" ? "Already the lowest paid tier. Check that each Limited user still needs to log in at all." : row["mastype"] == "SELFSERVICE" ? "Nothing to do. Self-service users do not consume AppPoints." : ""]]></expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">share</property>
                    <expression name="expression" type="javascript"><![CDATA[row["users"] + " users"]]></expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="pageBreakInterval">0</property>
            <column id="317"><property name="width">1.1in</property></column><column id="318"><property name="width">0.8in</property></column><column id="319"><property name="width">0.6in</property></column><column id="320"><property name="width">1.0in</property></column><column id="321"><property name="width">3.5in</property></column><column id="322"><property name="width">3.1in</property></column>
            <header><row id="336"><cell id="323"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="305"><text-property name="text">Type</text-property></label></cell><cell id="324"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="306"><text-property name="text">AppPoints each</text-property></label></cell><cell id="325"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="307"><text-property name="text">Users</text-property></label></cell><cell id="326"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="308"><text-property name="text">AppPoints (all authorized)</text-property></label></cell><cell id="327"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="309"><text-property name="text">Who lands here</text-property></label></cell><cell id="328"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="310"><text-property name="text">How to lower it</text-property></label></cell></row></header>
            <detail><row id="337"><list-property name="highlightRules">
                <structure>
                    <property name="operator">eq</property><property name="backgroundColor">#f6f2ff</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"PREMIUM"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="backgroundColor">#edf5ff</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"BASE"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="backgroundColor">#e8f8f7</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"LIMITED"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="backgroundColor">#f4f4f4</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"SELFSERVICE"</value></simple-property-list>
                </structure></list-property><cell id="329"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="311"><property name="fontSize">10pt</property><list-property name="highlightRules">
                <structure>
                    <property name="operator">eq</property><property name="color">#8a3ffc</property><property name="fontWeight">bold</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"PREMIUM"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"BASE"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="color">#009d9a</property><property name="fontWeight">bold</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"LIMITED"</value></simple-property-list>
                </structure>
                <structure>
                    <property name="operator">eq</property><property name="color">#6f6f6f</property><property name="fontWeight">bold</property>
                    <expression name="testExpr" type="javascript">row["mastype"]</expression>
                    <simple-property-list name="value1"><value type="javascript">"SELFSERVICE"</value></simple-property-list>
                </structure></list-property><property name="resultSetColumn">label</property></data></cell><cell id="330"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="312"><property name="fontSize">10pt</property><property name="fontWeight">bold</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">pointseach</property></data></cell><cell id="331"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="313"><property name="fontSize">10pt</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">users</property></data></cell><cell id="332"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="314"><property name="fontSize">10pt</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">points</property></data></cell><cell id="333"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="315"><property name="fontSize">8pt</property><property name="color">#161616</property><property name="resultSetColumn">what</property></data></cell><cell id="334"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="316"><property name="fontSize">8pt</property><property name="color">#525252</property><property name="resultSetColumn">reduce</property></data></cell></row></detail>
        </table><label id="339"><property name="fontSize">13pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="marginTop">18pt</property><property name="marginBottom">2pt</property><text-property name="text">Appendix B - Security groups driving Premium</text-property></label><label id="338"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">6pt</property><text-property name="text">Groups that give Premium users create rights in add-on (PLUS*) applications, by number of Premium members. Changing a group here moves every member it affects.</text-property></label>
        <table id="360">
            <property name="width">10.10in</property>
            <property name="dataSet">dsPremGroups</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">groupname</property>
                    <expression name="expression" type="javascript">dataSetRow["groupname"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">description</property>
                    <expression name="expression" type="javascript">dataSetRow["description"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">premium_users</property>
                    <expression name="expression" type="javascript">dataSetRow["premium_users"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">plusapps</property>
                    <expression name="expression" type="javascript">dataSetRow["plusapps"]</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="pageBreakInterval">0</property>
            <column id="348"><property name="width">1.6in</property></column><column id="349"><property name="width">2.6in</property></column><column id="350"><property name="width">1.0in</property></column><column id="351"><property name="width">4.9in</property></column>
            <header><row id="361"><cell id="352"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="340"><text-property name="text">Security group</text-property></label></cell><cell id="353"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="341"><text-property name="text">Description</text-property></label></cell><cell id="354"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="342"><text-property name="text">Premium members</text-property></label></cell><cell id="355"><property name="backgroundColor">#161616</property><property name="color">#ffffff</property><property name="fontWeight">bold</property><property name="fontSize">8pt</property><property name="paddingTop">4pt</property><property name="paddingBottom">4pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><label id="343"><text-property name="text">Add-on apps with create rights</text-property></label></cell></row></header>
            <detail><row id="362"><list-property name="highlightRules">
                <structure>
                    <property name="operator">eq</property>
                    <property name="backgroundColor">#f4f4f4</property>
                    <expression name="testExpr" type="javascript">row.__rownum % 2</expression>
                    <simple-property-list name="value1"><value type="javascript">1</value></simple-property-list>
                </structure>
            </list-property><cell id="356"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="344"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="resultSetColumn">groupname</property></data></cell><cell id="357"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="345"><property name="fontSize">8.5pt</property><property name="resultSetColumn">description</property></data></cell><cell id="358"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="346"><property name="fontSize">8.5pt</property><property name="textAlign">center</property><structure name="numberFormat"><property name="category">Custom</property><property name="pattern">#,##0</property></structure><property name="resultSetColumn">premium_users</property></data></cell><cell id="359"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="paddingLeft">5pt</property><property name="paddingRight">5pt</property><property name="verticalAlign">top</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><data id="347"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="resultSetColumn">plusapps</property></data></cell></row></detail>
        </table><label id="363"><property name="fontSize">13pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="marginTop">18pt</property><property name="marginBottom">6pt</property><text-property name="text">Appendix C - Method and limits</text-property></label><grid id="389"><property name="width">10.1in</property>
            <column id="390"><property name="width">1.7in</property></column><column id="391"><property name="width">8.4in</property></column><row id="364"><cell id="365"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="366"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">How this is calculated</text-property></label></cell>
                <cell id="367"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="368"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">The rules of IBM's Magic Script 2.6.3, run as read-only queries: no tables or indexes are created. Only security groups (GROUPUSER, APPLICATIONAUTH, MAXMENU) and login history (LOGINTRACKING) are read.</text-property></label></cell></row><row id="369"><cell id="370"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="371"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">AppPoints per user</text-property></label></cell>
                <cell id="372"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="373"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Self service 0, Limited 5, Base 10, Premium 15 - the rates the Magic Script uses.</text-property></label></cell></row><row id="374"><cell id="375"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="376"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">All users vs at peak</text-property></label></cell>
                <cell id="377"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="378"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">"All users" counts every paying user at once. "At peak" counts only the users in session at the busiest moment, which is what concurrent AppPoints are measured against.</text-property></label></cell></row><row id="379"><cell id="380"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="381"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Peaks</text-property></label></cell>
                <cell id="382"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="383"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Taken from LOGINTRACKING.CURRENTCOUNT, which Maximo records at most every 15 minutes, so the real peak can be slightly higher. Login tracking must be switched on. MAXADMIN, MXINTADM and MAXREG are left out of peak sessions, as in the original script.</text-property></label></cell></row><row id="384"><cell id="385"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="386"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Not included</text-property></label></cell>
                <cell id="387"><property name="paddingTop">2pt</property><property name="paddingBottom">2pt</property><label id="388"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Add-on install charges (for example Spatial) and anything outside Manage. This is an estimate, not an IBM licence audit.</text-property></label></cell></row></grid>
    </body>
</report>
